{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@core/*": ["./core/*"],
      "@sim/*": ["./sim/*"],
      "@canvas/*": ["./canvas/*"]
    },
    "outDir": "./dist"
  },
  "include": ["./**/*.ts", "./**/*.d.ts"],
  "exclude": []
}
